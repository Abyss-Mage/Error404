# Copy to .env for local runs. On Vercel, set these in Project Settings > Environment Variables.
# Keys must be at least 16 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

# One admin, shown as "Admin":
ADMIN_KEY=
# Or one key per teammate (remove someone's entry to revoke their access):
# ADMIN_KEYS=Sam:first-long-random-key,Alex:second-long-random-key

# Added automatically when you connect Upstash Redis from the Vercel Storage tab:
KV_REST_API_URL=
KV_REST_API_TOKEN=
